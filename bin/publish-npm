#!/usr/bin/env bash
# Build and publish @propraven/sdk. Skips when this version is already on npm.
# In GitHub Actions it uses npm trusted publishing (OIDC, needs npm >= 11.5 and
# `id-token: write`); elsewhere set NPM_TOKEN.
set -euo pipefail

cd "$(dirname "$0")/.."

PACKAGE_NAME="$(node -p "require('./package.json').name")"
VERSION="$(node -p "require('./package.json').version")"

PUBLISHED="$(npm view "${PACKAGE_NAME}@${VERSION}" version 2>/dev/null || true)"
if [[ "$PUBLISHED" == "$VERSION" ]]; then
  echo "${PACKAGE_NAME}@${VERSION} is already on npm; nothing to publish."
  exit 0
fi

if [[ -n "${NPM_TOKEN:-}" ]]; then
  npm config set '//registry.npmjs.org/:_authToken' "$NPM_TOKEN"
elif [[ -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]]; then
  echo "ERROR: set NPM_TOKEN, or run in GitHub Actions with id-token: write (trusted publishing)." >&2
  exit 1
fi

# Prereleases (1.2.3-beta.1) go to their own dist-tag; everything else is `latest`.
TAG="latest"
if [[ "$VERSION" =~ -([a-zA-Z]+) ]]; then
  TAG="${BASH_REMATCH[1]}"
fi

npm run build

# Trusted publishing needs npm >= 11.5.
npm install -g npm@latest
npm --version

npm publish --provenance --access public --tag "$TAG"
